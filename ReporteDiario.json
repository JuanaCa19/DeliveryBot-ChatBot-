    {
      "parameters": {
        "jsCode": "const pedidos = $input.all().map(i => i.json);\n\nlet totalVendido = 0;\nconst conteoProductos = {};\nconst conteoHoras = {};\n\nfor (const p of pedidos) {\n  totalVendido += Number(p.total_pago || 0);\n\n  let items = [];\n  try { items = JSON.parse(p.detalles_pedido || \"[]\"); } catch (e) { items = []; }\n  for (const it of items) {\n    conteoProductos[it.nombre] = (conteoProductos[it.nombre] || 0) + Number(it.cantidad || 0);\n  }\n\n  if (p.hora) {\n    const hora = String(p.hora).split(\":\")[0];\n    conteoHoras[hora] = (conteoHoras[hora] || 0) + 1;\n  }\n}\n\nlet productoEstrella = \"N/A\";\nlet maxCant = 0;\nfor (const [nombre, cant] of Object.entries(conteoProductos)) {\n  if (cant > maxCant) { maxCant = cant; productoEstrella = nombre; }\n}\n\nlet horaPico = \"N/A\";\nlet maxPedidos = 0;\nfor (const [hora, cant] of Object.entries(conteoHoras)) {\n  if (cant > maxPedidos) { maxPedidos = cant; horaPico = `${hora}:00`; }\n}\n\nconst mensaje = `\\ud83d\\udcca *Reporte diario DeliveryBot*\\n\\n\\ud83d\\udcb0 Total vendido: $${totalVendido.toLocaleString(\"es-CO\")}\\n\\ud83d\\udce6 Pedidos del d\\u00eda: ${pedidos.length}\\n\\u2b50 Producto estrella: ${productoEstrella} (${maxCant} unidades)\\n\\u23f0 Hora pico: ${horaPico} (${maxPedidos} pedidos)`;\n\nreturn [{ json: { mensaje } }];\n"
      },
